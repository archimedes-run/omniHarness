{
  "$comment": "Spec 011 FR-020..FR-023: the one schema the host page (core/apps/protocol.ts) and the platform shim (shim/omni-shim.js, generated by scripts/build-app-shim.mjs) both validate against. Each message is a plain JSON object; unknown types, unknown keys and values outside these rules are refused. A property whose schema is {\"json\": true} is any plain JSON value.",
  "version": 1,
  "limits": {
    "frame_to_host_max_bytes": 8192,
    "host_to_frame_max_bytes": 262144,
    "frame_to_host_per_second": 30
  },
  "frame_to_host": {
    "data": {
      "v": {
        "const": 1
      },
      "type": {
        "const": "data"
      },
      "id": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-]{1,64}$"
      },
      "source": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]{0,31}$"
      }
    },
    "refresh": {
      "v": {
        "const": 1
      },
      "type": {
        "const": "refresh"
      },
      "id": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-]{1,64}$"
      },
      "source": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]{0,31}$"
      }
    },
    "open": {
      "v": {
        "const": 1
      },
      "type": {
        "const": "open"
      },
      "url": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2048
      }
    },
    "connect": {
      "v": {
        "const": 1
      },
      "type": {
        "const": "connect"
      },
      "source": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]{0,31}$"
      }
    }
  },
  "frame_to_host_window": {
    "hello": {
      "v": {
        "const": 1
      },
      "type": {
        "const": "hello"
      },
      "nonce": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-]{16,64}$"
      }
    }
  },
  "host_to_frame": {
    "init": {
      "v": {
        "const": 1
      },
      "type": {
        "const": "init"
      },
      "app": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]{0,47}$"
      },
      "version": {
        "type": "integer",
        "minimum": 1,
        "maximum": 1000000
      },
      "theme": {
        "enum": ["light", "dark"]
      }
    },
    "result": {
      "v": {
        "const": 1
      },
      "type": {
        "const": "result"
      },
      "id": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-]{1,64}$"
      },
      "source": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]{0,31}$"
      },
      "state": {
        "enum": ["fresh", "empty", "not_connected", "failed"]
      },
      "data": {
        "json": true
      },
      "fetched_at": {
        "type": ["string", "null"],
        "maxLength": 64
      },
      "stale": {
        "type": "boolean"
      },
      "reason": {
        "type": ["string", "null"],
        "maxLength": 300,
        "optional": true
      }
    },
    "update": {
      "v": {
        "const": 1
      },
      "type": {
        "const": "update"
      },
      "source": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]{0,31}$"
      },
      "state": {
        "enum": ["fresh", "empty", "not_connected", "failed"]
      },
      "data": {
        "json": true
      },
      "fetched_at": {
        "type": ["string", "null"],
        "maxLength": 64
      },
      "stale": {
        "type": "boolean"
      },
      "reason": {
        "type": ["string", "null"],
        "maxLength": 300,
        "optional": true
      }
    },
    "theme": {
      "v": {
        "const": 1
      },
      "type": {
        "const": "theme"
      },
      "theme": {
        "enum": ["light", "dark"]
      }
    },
    "error": {
      "v": {
        "const": 1
      },
      "type": {
        "const": "error"
      },
      "id": {
        "type": ["string", "null"],
        "maxLength": 64,
        "optional": true
      },
      "reason": {
        "type": "string",
        "maxLength": 300
      }
    }
  }
}
